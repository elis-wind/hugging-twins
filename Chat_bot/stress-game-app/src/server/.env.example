# Backend Environment Variables (Node.js/Express)

# Google Gemini API Key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection URI
# Local: mongodb://localhost:27017/stress-game-app
# Cloud (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net/stress-game-app
MONGODB_URI=mongodb://localhost:27017/stress-game-app

# Server Port (optional, defaults to 5001)
PORT=5001
